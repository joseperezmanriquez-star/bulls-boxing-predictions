<!DOCTYPE html>
<html lang="es">
<head>
  <title>Monitor en vivo - Bulls Boxing</title>
  <%- include('partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="monitor-body" style="background-image: linear-gradient(180deg, rgba(20,16,13,0.82) 0%, rgba(20,16,13,0.93) 100%), url('/img/gym/gym-ring.jpg');">
  <img class="ring-corner corner-tl" src="/img/ring-corner.svg" alt="">
  <img class="ring-corner corner-tr" src="/img/ring-corner.svg" alt="">
  <img class="ring-corner corner-bl" src="/img/ring-corner.svg" alt="">
  <img class="ring-corner corner-br" src="/img/ring-corner.svg" alt="">

  <div class="monitor-wrap">
    <img src="/img/bulls-logo.jpg" alt="Bulls Training" class="monitor-logo">
    <div id="monitorClock" class="monitor-clock"></div>
    <div id="fightDots" class="fight-dots"></div>
    <select id="fightSelect" class="monitor-select monitor-select-hidden"></select>
    <h1 id="fightTitle" class="monitor-title"><img class="title-glove" src="/img/glove.svg" alt="">Cargando...</h1>
    <div class="monitor-chart-wrap">
      <canvas id="monitorChart"></canvas>
    </div>
    <div id="monitorPercentages" class="monitor-pct"></div>
  </div>

  <div class="ticker">
    <div class="ticker-label">&#129354; Proximas peleas</div>
    <div class="ticker-viewport">
      <div id="tickerTrack" class="ticker-track"></div>
    </div>
  </div>

  <script>
    const socket = io();
    let chart = null;
    let fights = [];
    let currentFightId = null;
    let currentIndex = 0;
    let countdownSecs = 60;
    let countdownTimer = null;

    const select = document.getElementById('fightSelect');
    const title = document.getElementById('fightTitle');
    const pctBox = document.getElementById('monitorPercentages');
    const clockBox = document.getElementById('monitorClock');
    const tickerTrack = document.getElementById('tickerTrack');
    const dotsBox = document.getElementById('fightDots');

    function renderDots() {
      if (fights.length <= 1) { dotsBox.innerHTML = ''; return; }
      dotsBox.innerHTML = fights.map(function(f, i) {
        return '<span class="fight-dot' + (i === currentIndex ? ' fight-dot-active' : '') + '" data-i="' + i + '"></span>';
      }).join('');
      dotsBox.querySelectorAll('.fight-dot').forEach(function(d) {
        d.addEventListener('click', function() { showFight(Number(d.dataset.i)); });
      });
    }

    function updateClock() {
      const now = new Date();
      const fecha = now.toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      const hora = now.toLocaleTimeString('es-CL');
      clockBox.textContent = fecha.charAt(0).toUpperCase() + fecha.slice(1) + ' — ' + hora;
    }
    updateClock();
    setInterval(updateClock, 1000);

    function showFight(index) {
      if (!fights.length) return;
      currentIndex = ((index % fights.length) + fights.length) % fights.length;
      currentFightId = fights[currentIndex].id;
      select.value = currentFightId;
      socket.emit('subscribe', currentFightId);
      renderDots();
      resetCountdown();
    }

    function resetCountdown() {
      countdownSecs = 60;
    }

    function updateCountdown() { /* dots handle progress visually */ }

    function startAutoRotate() {
      if (countdownTimer) clearInterval(countdownTimer);
      countdownTimer = setInterval(function () {
        countdownSecs -= 1;
        updateCountdown();
        if (countdownSecs <= 0) {
          showFight(currentIndex + 1);
        }
      }, 1000);
    }

    function renderTicker() {
      const proximas = fights.filter(function (f) { return f.status !== 'settled'; });
      if (!proximas.length) {
        tickerTrack.innerHTML = '<span class="ticker-item">Por el momento no hay proximas peleas programadas.</span>';
        return;
      }
      const items = proximas.map(function (f) {
        const estado = f.status === 'open' ? 'Pronosticos abiertos' : 'Apuestas cerradas';
        return '<span class="ticker-item">&#129354; ' + f.fighterA + ' <span class="vs">vs</span> ' + f.fighterB
          + ' &nbsp;&middot;&nbsp; ' + f.date + ' &nbsp;&middot;&nbsp; <span class="ticker-status">' + estado + '</span></span>';
      }).join('<span class="ticker-sep">&#9679;</span>');
      tickerTrack.innerHTML = items + '<span class="ticker-sep">&#9679;</span>' + items + '<span class="ticker-sep">&#9679;</span>';
    }

    select.addEventListener('change', function () {
      currentIndex = fights.findIndex(function (f) { return f.id === Number(select.value); });
      showFight(currentIndex);
    });

    socket.on('fights', function (list) {
      fights = list;
      select.innerHTML = fights.map(function (f) {
        return '<option value="' + f.id + '">' + f.fighterA + ' vs ' + f.fighterB + ' (' + f.date + ')</option>';
      }).join('');
      if (fights.length) {
        showFight(0);
        startAutoRotate();
      }
      renderTicker();
    });

    socket.on('stats', function (s) {
      if (!s || s.fight.id !== currentFightId) return;

      title.innerHTML = '<img class="title-glove" src="/img/glove.svg" alt="">'
        + s.fight.fighterA + ' <span style="color:#e8b923;font-size:0.6em;vertical-align:middle;">VS</span> ' + s.fight.fighterB;

      const labels = Object.keys(s.totals);
      const values = labels.map(function (l) { return s.totals[l]; });
      const pcts   = labels.map(function (l) { return s.percentages[l]; });

      pctBox.innerHTML = labels.map(function (l, i) {
        return '<div class="monitor-pct-item">'
          + '<img class="pct-glove pct-glove-' + i + '" src="/img/glove.svg" alt="">'
          + l + ': <strong>' + pcts[i] + '%</strong> (' + values[i].toLocaleString('es-CL') + ' Bulls)'
          + '</div>';
      }).join('');

      if (chart) {
        chart.data.labels = labels;
        chart.data.datasets[0].data = values;
        chart.update();
      } else {
        const ctx = document.getElementById('monitorChart');
        chart = new Chart(ctx, {
          type: 'pie',
          data: {
            labels: labels,
            datasets: [{ data: values, backgroundColor: ['#c0392b', '#2980b9'] }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: { legend: { labels: { font: { size: 18 }, color: '#f1ece6' } } }
          }
        });
      }
    });

    socket.emit('requestFights');
  </script>
</body>
</html>
